# craw test 1: uniform 1-D background, periodic, no variations.
# Gas: rho = 1, v_x = 0.5, B_x = 1, P = 1. CR: E_c = 1, f_c = gamma_c v E_c, waves uniform.
# Nothing should change: every quantity is uniform, so this checks the zero-gradient limit.

<comment>
problem   = craw uniform background (test 1)

<job>
basename  = craw_test1_uniform

<mesh>
nghost    = 3
nx1       = 64
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 0.1
ndiag      = 1

<mhd>
eos       = ideal
gamma     = 1.6666666667
reconstruct = plm
rsolver   = hlld
dfloor    = 1.0e-8
pfloor    = 1.0e-8

<craw>
v_max     = 200.0
lorentz   = 2.0
ncr_sub   = 20
atol      = 1.0e-8
rtol      = 1.0e-6
efloor    = 1.0e-12
wfloor    = 1.0e-12

<problem>
pgen_name = craw_gaussian
rho       = 1.0
vx        = 0.5
Bx        = 1.0
pgas      = 1.0
bkg       = 1.0
bkgw      = 1.0e-6
impulse   = 0

<output1>
file_type = hst
dcycle    = 1
data_format = %12.5e

<output2>
file_type = tab
variable  = mhd_w
dt        = 0.1

<output3>
file_type = tab
variable  = craw_u
dt        = 0.1
